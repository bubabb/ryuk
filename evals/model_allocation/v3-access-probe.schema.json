{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ryuk.invalid/schemas/model-allocation-v3-access-probe.json",
  "title": "Ryuk model-allocation v3 model-access probe receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "id", "manifest_sha256", "observed_at", "environment_id",
    "successful", "assignments", "evidence_sha256"
  ],
  "properties": {
    "version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "observed_at": {"type": "string", "format": "date-time"},
    "environment_id": {"type": "string", "minLength": 1},
    "successful": {"const": true},
    "assignments": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["model", "effort"],
        "properties": {
          "model": {"type": "string", "minLength": 1},
          "effort": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
