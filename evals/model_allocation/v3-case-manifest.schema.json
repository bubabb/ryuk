{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ryuk.invalid/schemas/model-allocation-v3-curation.json",
  "title": "Ryuk model-allocation v3 sealed curation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "purpose", "baseline_commit", "curation", "cases"],
  "properties": {
    "version": {"const": 3},
    "purpose": {"type": "string", "minLength": 1},
    "baseline_commit": {"$ref": "#/$defs/gitSha1"},
    "curation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "curator_id",
        "candidate_author_ids",
        "independent_from_candidate_authors",
        "completed_before_candidate_access",
        "blind_to_arm_outcomes",
        "selection_method",
        "sampling_frame_sha256"
      ],
      "properties": {
        "curator_id": {"type": "string", "minLength": 1},
        "candidate_author_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "independent_from_candidate_authors": {"const": true},
        "completed_before_candidate_access": {"const": true},
        "blind_to_arm_outcomes": {"const": true},
        "selection_method": {"type": "string", "minLength": 1},
        "sampling_frame_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 100,
      "maxItems": 100,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitSha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "stringList": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "stratum", "category", "prompt", "critical", "source",
        "holdout", "grading", "allocation"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "stratum": {
          "enum": [
            "bounded_evidence_and_documentation",
            "scoped_implementation",
            "security_and_tenant_boundaries",
            "concurrency_and_recovery",
            "architecture_and_evaluation"
          ]
        },
        "category": {"type": "string", "minLength": 1},
        "prompt": {"type": "string", "minLength": 1},
        "critical": {"type": "boolean"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reference", "content_sha256"],
          "properties": {
            "kind": {"enum": ["synthetic", "public"]},
            "reference": {"type": "string", "minLength": 1},
            "content_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "holdout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "absent_from_v1_v2",
            "absent_from_candidate_examples",
            "unseen_by_candidate_authors"
          ],
          "properties": {
            "absent_from_v1_v2": {"const": true},
            "absent_from_candidate_examples": {"const": true},
            "unseen_by_candidate_authors": {"const": true}
          }
        },
        "grading": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "expected": {"not": {"type": "null"}},
            "checks": {"$ref": "#/$defs/stringList"},
            "review_criteria": {"$ref": "#/$defs/stringList"}
          },
          "oneOf": [
            {"required": ["expected"]},
            {"required": ["checks"]},
            {"required": ["review_criteria"]}
          ]
        },
        "allocation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "effort"],
          "properties": {
            "model": {"enum": ["gpt-6-luna", "gpt-6-sol", "gpt-6-astra"]},
            "effort": {"enum": ["low", "medium", "high"]}
          }
        }
      }
    }
  }
}
