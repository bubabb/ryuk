{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ryuk.invalid/schemas/model-allocation-v3-review-ledger.json",
  "title": "Ryuk model-allocation v3 finalized blinded-review ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "manifest_sha256", "run_sha256", "response_set_sha256", "reviewer_id",
    "candidate_author_ids", "independent", "blinding", "reviews"
  ],
  "properties": {
    "version": {"const": 1},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "run_sha256": {"$ref": "#/$defs/sha256"},
    "response_set_sha256": {"$ref": "#/$defs/sha256"},
    "reviewer_id": {"type": "string", "minLength": 1},
    "candidate_author_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "independent": {"const": true},
    "blinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alias_map_sha256", "arm_labels_hidden_until_scores_frozen",
        "scores_frozen_at", "unblinded_at"
      ],
      "properties": {
        "alias_map_sha256": {"$ref": "#/$defs/sha256"},
        "arm_labels_hidden_until_scores_frozen": {"const": true},
        "scores_frozen_at": {"type": "string", "format": "date-time"},
        "unblinded_at": {"type": "string", "format": "date-time"}
      }
    },
    "reviews": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "blind_id", "task_id", "response_sha256", "verdict", "notes"
        ],
        "properties": {
          "blind_id": {"type": "string", "pattern": "^B(00[1-9]|0[1-9][0-9]|1[0-9]{2}|200)$"},
          "task_id": {"type": "string", "minLength": 1},
          "response_sha256": {"$ref": "#/$defs/sha256"},
          "verdict": {"enum": ["pass", "fail", "invalid_task"]},
          "notes": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
