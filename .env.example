APP_ENV=development
APP_NAME=Ryuk AI
APP_VERSION=0.1.0
MAX_PROMPT_CHARS=100000
MAX_REQUEST_BODY_BYTES=1048576
MAX_GENERATION_TOKENS=32768
RUNTIME_PROBE_TIMEOUT_SECONDS=3
RUNTIME_STATE_TTL_SECONDS=15
RUNTIME_REFRESH_INTERVAL_SECONDS=5
CONTROL_PLANE_CONFIG_PATH=
EXECUTION_RECORD_PATH=

# Optional provider credentials. These are not Ryuk's internal protocol.
KIMI_API_URL=
KIMI_API_KEY=
NVIDIA_API_KEY=
KIMI_SECRET_REF=
NVIDIA_SECRET_REF=

# Native inference deployments
SGLANG_ENABLED=true
SGLANG_BASE_URL=http://127.0.0.1:30000
SGLANG_DEPLOYMENT_ID=sglang-local
SGLANG_ENDPOINT_ID=sglang-local-http
SGLANG_CONNECT_TIMEOUT_SECONDS=5
SGLANG_READ_TIMEOUT_SECONDS=120
SGLANG_WRITE_TIMEOUT_SECONDS=10
SGLANG_POOL_TIMEOUT_SECONDS=5
SGLANG_IDENTITY_TIMEOUT_SECONDS=3
SGLANG_MAX_RESPONSE_BYTES=16777216
SGLANG_MAX_CONTEXT_TOKENS=
SGLANG_ACCELERATORS=
SGLANG_TOPOLOGY=
SGLANG_DATA_LOCATIONS=
SGLANG_PRODUCTION_ELIGIBLE=false
SGLANG_COST_CLASS=unknown
SGLANG_LATENCY_CLASS=unknown
SGLANG_TEXT_SUITABILITY=5
# Configure these before treating SGLang model identity as verified.
SGLANG_MODEL_ARTIFACT_ID=
SGLANG_MODEL_REVISION=
SGLANG_SERVED_MODEL_NAME=
SGLANG_ENGINE_VERSION=
SGLANG_SERVING_RUNTIME=standalone

VLLM_ENABLED=false
VLLM_BASE_URL=http://127.0.0.1:8000
VLLM_DEPLOYMENT_ID=vllm-worker
VLLM_ENDPOINT_ID=vllm-worker-http
VLLM_MODEL_ARTIFACT_ID=
VLLM_MODEL_REVISION=
VLLM_ENGINE_VERSION=0.26.0
VLLM_MAX_CONTEXT_TOKENS=
VLLM_ACCELERATORS=
VLLM_TOPOLOGY=
VLLM_DATA_LOCATIONS=
VLLM_PRODUCTION_ELIGIBLE=false
VLLM_COST_CLASS=unknown
VLLM_LATENCY_CLASS=unknown
VLLM_TEXT_SUITABILITY=5
VLLM_CHAT_SUITABILITY=5

TENSORRT_LLM_ENABLED=false
TENSORRT_LLM_BASE_URL=http://127.0.0.1:8001

DYNAMO_ENABLED=false
DYNAMO_BASE_URL=http://127.0.0.1:8002
DYNAMO_DEPLOYMENT_ID=dynamo-deployment
DYNAMO_ENDPOINT_ID=dynamo-frontend-http
DYNAMO_MODEL_ARTIFACT_ID=
DYNAMO_MODEL_REVISION=
DYNAMO_RUNTIME_VERSION=1.4.1
DYNAMO_TOPOLOGY=aggregated
DYNAMO_MAX_CONTEXT_TOKENS=
DYNAMO_ACCELERATORS=
DYNAMO_DATA_LOCATIONS=
DYNAMO_PRODUCTION_ELIGIBLE=false
DYNAMO_COST_CLASS=unknown
DYNAMO_LATENCY_CLASS=unknown

NIM_ENABLED=false
NIM_BASE_URL=http://127.0.0.1:8003
NIM_API_KEY=
NIM_SECRET_REF=
NIM_DEPLOYMENT_ID=nim-deployment
NIM_ENDPOINT_ID=nim-http
NIM_MODEL_ARTIFACT_ID=
NIM_MODEL_REVISION=
NIM_RELEASE=2.0.11
NIM_PROFILE_ID=
NIM_BACKEND=vllm
NIM_MAX_CONTEXT_TOKENS=
NIM_ACCELERATORS=
NIM_TOPOLOGY=
NIM_DATA_LOCATIONS=
NIM_PRODUCTION_ELIGIBLE=false
NIM_COST_CLASS=unknown
NIM_LATENCY_CLASS=unknown

# Development-only deterministic engine. A later milestone will enforce this
# restriction in application configuration.
MOCK_ENABLED=true
MOCK_DEPLOYMENT_ID=mock-development

# Optional persistence services
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
